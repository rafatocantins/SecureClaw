# Tessera environment — example / documentation
# Copy to .env and fill in your values, or run: tessera init
#
# NEVER commit .env — it is already in .gitignore.

# ── Gateway ──────────────────────────────────────────────────────────────────
# 64-character hex string. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GATEWAY_HMAC_SECRET=change-me-generate-with-tessera-init

# ── Credential vault (AES-256-GCM encrypted-file fallback) ──────────────────
# Used only when keytar (OS keychain) is unavailable (headless Linux / WSL / CI).
VAULT_MASTER_KEY=change-me-generate-with-tessera-init

# ── LLM provider ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-sonnet-4-6

# Ollama (local, no API key required)
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# ── Optional overrides (defaults shown) ──────────────────────────────────────
# GATEWAY_PORT=18789
# GATEWAY_HOST=127.0.0.1
# TOKEN_EXPIRY_SECONDS=300   # Token validity window in seconds (30–604800). Default: 300 (5 min).
# AUDIT_DATA_DIR=/tmp/tessera-audit
# VAULT_DATA_DIR=/tmp/tessera-vault
# MEMORY_DATA_DIR=/data/memory
# SKILLS_REGISTRY_PATH=/tmp/tessera-skills-registry.json
# MARKETPLACE_REGISTRY_PATH=/tmp/tessera-marketplace-registry.json
# AUDIT_COST_CAP_USD=5.0

# ── Web safety ────────────────────────────────────────────────────────────────
# TESSERA_REQUIRE_TLS=true         # Block plain http:// URLs (default: true). Set to false to permit.
# HTTP_ALLOWED_DOMAINS=            # Comma-separated domain allowlist. Empty = all external domains allowed.
# HTTP_BLOCKED_DOMAINS=            # Comma-separated domain blocklist. Always applied regardless of allowlist.

# ── Agent safety ──────────────────────────────────────────────────────────────
# AGENT_MAX_TURNS_PER_SESSION=20   # Max LLM round-trips per session (default: 20, range: 1–500).
#                                  # Prevents runaway agents from burning API budget on infinite loops.

# ── Observability (OpenTelemetry) ────────────────────────────────────────────
# OTLP endpoint for distributed tracing (Jaeger, Grafana Tempo, Honeycomb, Datadog, etc.)
# Default: disabled — no overhead when unset. Standard OTLP/HTTP port: 4318.
# Trace data includes: gateway HTTP spans + agent LLM calls, tool executions, approval waits.
# To enable with Jaeger locally: uncomment the jaeger service in docker-compose.dev.yml, then:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
